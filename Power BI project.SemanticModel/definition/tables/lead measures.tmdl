table 'lead measures'
	lineageTag: fec4468b-282b-409f-8a93-e25678657f4a

	measure 'total leads' = ```
			COUNT(leads[lead_id]) 
			```
		formatString: 0
		lineageTag: e572a14c-bf59-44d9-a5b8-266cea746d15

	measure 'converted leads' = ```
